# =============================================================================
# YTM Queue Saver - backend environment
#
# Copy to `.env` and fill in. NEVER commit the filled-in file.
#
#   cp .env.example .env
#
# Generate the secrets marked <generate> with:
#
#   # 32-byte AES-256 key, base64
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
#   # RS256 keypair for session JWTs (both halves go in your secret store)
#   python -c "from cryptography.hazmat.primitives.asymmetric import rsa;\
# from cryptography.hazmat.primitives import serialization as s;\
# k=rsa.generate_private_key(public_exponent=65537,key_size=2048);\
# print(k.private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption()).decode());\
# print(k.public_key().public_bytes(s.Encoding.PEM,s.PublicFormat.SubjectPublicKeyInfo).decode())"
#
#   # legacy Fernet key, only needed to read tokens written before the AES migration
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#
# PEM keys are multi-line: store them as real newlines, or as literal "\n".
# =============================================================================

# --- Deployment mode ---------------------------------------------------------
# production enables every fail-closed behaviour: required secrets, no
# /api/auth/test-login, no Swagger UI, no OpenAPI schema, HSTS + CSP.
APP_ENV=development

# --- Database ----------------------------------------------------------------
# Either DATABASE_URL, or the DB_* parts (DATABASE_URL wins if both are set).
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ytm_queue_saver
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ytm_queue_saver

# --- Google OAuth ------------------------------------------------------------
# REQUIRED. The published extension uses this client; its ID must match, or
# every Google sign-in will be rejected with 401.
YTM_CLIENT_ID=
# Only for a *confidential* Google OAuth client. A public/installed client needs
# no secret. Leave empty for the extension's client.
# YTM_CLIENT_SECRET=

# --- Token encryption --------------------------------------------------------
# REQUIRED in production. AES-256-GCM envelope key, base64 of 32 random bytes.
# <generate>
KMS_MASTER_KEY=
# Identifies the active key so you can rotate without rewriting existing rows.
KMS_MASTER_KEY_ID=v3-primary
# Comma-separated older keys, as "<id>:<base64 key>", decrypted with when reading.
# Needed during a rotation; keep the previous key here until every row has been
# re-encrypted. <generate>
# KMS_MASTER_KEY_PREVIOUS=v2-previous:REPLACE_WITH_BASE64_KEY

# REQUIRED if this deployment still has tokens written before the AES envelope
# migration. Those rows are Fernet-encrypted and are re-wrapped on first read.
# <generate>
FERNET_KEY=

# --- Session JWTs (RS256) ----------------------------------------------------
# REQUIRED in production. Both halves must be stored; neither may be the default.
# <generate>
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRE_MINUTES=10080
# How long revoked JTIs are retained before being pruned.
REVOKED_TOKEN_RETENTION_DAYS=30

# --- CORS --------------------------------------------------------------------
# Exact origins, comma-separated, no wildcards and no trailing slash.
# The published extension sends Origin:
#   chrome-extension://iegedaeoaampnaagmbfdefigjecepigo
ALLOWED_ORIGINS=chrome-extension://iegedaeoaampnaagmbfdefigjecepigo
# Advanced: a full-match regex instead of a list. Prefer ALLOWED_ORIGINS.
# ALLOWED_ORIGIN_REGEX=

# Validated Host header allowlist. Leave empty on Render/Heroku/Railway/Fly,
# where the public hostname is assigned by the platform.
# ALLOWED_HOSTS=api.example.com,www.example.com

# --- Request hardening -------------------------------------------------------
MAX_REQUEST_BODY_BYTES=2097152
MAX_TRACKS_PER_SNAPSHOT=1000
MAX_TOKEN_PAYLOAD_BYTES=16384

# --- Security headers --------------------------------------------------------
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
ENABLE_CSP=true
# CSP_VALUE=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# --- Rate limits -------------------------------------------------------------
# Per-IP unless noted. Caps sit far above the extension's real pattern
# (one restore per user action).
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_TEST_LOGIN_PER_MIN=10
RATE_LIMIT_LOGOUT_PER_MIN=30
RATE_LIMIT_RESTORE_PER_MIN=10
RATE_LOGIN_PER_HOUR=60
RATE_RESTORE_PER_HOUR=120
RATE_DELETE_ACCOUNT_PER_MIN=3

# --- YouTube quota budget ----------------------------------------------------
# Unit costs are Google's published numbers (playlists.insert=50,
# playlistItems.insert=50, list calls=1). Only the totals are tunable here.
YOUTUBE_DAILY_QUOTA=10000
# 95% of the daily allowance: the headroom absorbs in-flight requests so an
# overshoot cannot push the project over Google's limit.
YTM_QUOTA_GLOBAL_CAP=9500
YTM_QUOTA_USER_CAP=5000
YTM_QUOTA_ALERT_WARN_PCT=70
YTM_QUOTA_ALERT_CRIT_PCT=90
# Status returned when a budget is exhausted. 502 keeps the extension's existing
# generic-failure UI; do not change without updating the client.
QUOTA_EXCEEDED_HTTP_STATUS=502

# --- YouTube call behaviour --------------------------------------------------
# Seconds a cached playlist ID is trusted before spending 1 unit re-verifying it.
# 0 verifies on every restore. Also bounds how long a user-deleted playlist can
# go unnoticed.
YTM_PLAYLIST_VERIFY_TTL_SECONDS=900
# 429 / quotaExceeded is NEVER retried; only 5xx and the transient 409 are.
YTM_MAX_RETRIES=2
YTM_RETRY_BASE_SECONDS=0.5
YTM_RETRY_MAX_SECONDS=8.0
YTM_HTTP_TIMEOUT_SECONDS=10
# Upper bound on playlistItems.list pages when rebuilding the local mirror.
YTM_PLAYLIST_SYNC_MAX_PAGES=40
# Stops a delete/recreate loop from draining the shared project quota.
YTM_MAX_PLAYLIST_CREATES_PER_USER_PER_DAY=20

# --- Feature flags -----------------------------------------------------------
# Every flag below defaults to OFF: the default must reproduce what the
# currently-published extension depends on. Turn on only after reading
# HARDENING.md.
#
# Collapses a video ID that repeats inside one snapshot into a single insert.
YTM_DEDUPE_WITHIN_SNAPSHOT=false
# Validates candidate IDs with videos.list (1 unit / 50 IDs) before spending 50
# units per insert on IDs that may be deleted or private.
YTM_VALIDATE_VIDEO_IDS=false
# Persists restores refused by an exhausted budget so they replay after the
# Pacific midnight reset. The live extension is synchronous, so a replay would
# create a playlist the user was told had failed.
YTM_DURABLE_REPLAY_QUEUE=false
# Persists a refreshed access token after a single-flight refresh. Off means a
# refresh is only used for the request that triggered it.
AUTH_PERSIST_REFRESHED_TOKEN=false
# Enforces the Origin header instead of only logging it. Turn on only after
# confirming the exact extension ID is listed in ALLOWED_ORIGINS.
ENFORCE_ORIGIN=false
# The ytmusicapi fallback creates a new playlist every run and bypasses quota
# accounting. Defaults ON outside production only.
YTM_ALLOW_YTMUSICAPI_FALLBACK=true

# --- Observability -----------------------------------------------------------
AUDIT_LOG_ENABLED=true
LOG_FORMAT_JSON=false

# --- Google scopes -----------------------------------------------------------
# Only consulted when YTM_CLIENT_ID is unset.
GOOGLE_YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube,https://www.googleapis.com/auth/youtube.force-ssl
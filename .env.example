# ==============================================================================
# YouTube Music Queue Saver - Production Environment Variables
# ==============================================================================

# 1. Database Connection (PostgreSQL - e.g. Supabase, Render, Neon, RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/saveQueueDB

# 2. Google OAuth 2.0 Client Credentials
# Create OAuth 2.0 Client IDs in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure YouTube Data API v3 is enabled in Google Cloud Console
YTM_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
YTM_CLIENT_SECRET=your-google-client-secret

# 3. Security & Cryptography
# JWT secret for signing session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=production-random-jwt-secret-key-replace-in-prod
JWT_EXPIRE_MINUTES=10080

# Fernet symmetric encryption key for encrypting stored OAuth credentials
# (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Note: If omitted, backend will deterministically derive a key from JWT_SECRET
FERNET_KEY=

# 4. CORS Origins
# Regex to match Chrome extension origins
ALLOWED_ORIGIN_REGEX=^chrome-extension://.*$
# Comma-separated list of allowed production domain origins
ALLOWED_ORIGINS=https://music.youtube.com
